# ==============================================================================
# HnBeeMusic — Environment Variables Template (Open Source & Self-Hosting)
# ==============================================================================
# 1. Sao chép file này thành `.env.local`:
#      cp .env.example .env.local
# 2. KHÔNG BAO GIỜ commit `.env.local` lên Git hoặc dùng prefix `NEXT_PUBLIC_`
#    cho các khóa bí mật (`CLIENT_SECRET`, `AUTH_SECRET`, `SERVICE_ROLE_KEY`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spotify Web API (Server-Only — Metadata & Playlist Extraction)
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 (Server-Only — Search & Stream Matching)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 3. SoundCloud Client ID (Tùy chọn — tự động fallback nếu để trống)
# ------------------------------------------------------------------------------
SOUNDCLOUD_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. OAuth Đăng Nhập (Server-Only — Google & Facebook)
# ------------------------------------------------------------------------------
# URL gốc của ứng dụng (ví dụ: https://hnbeemusic.vercel.app hoặc http://localhost:3000)
AUTH_URL=
# Khóa bí mật ký HttpOnly Session JWT & CSRF State (tạo bằng: openssl rand -base64 32)
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Database & Server Cloud Sync (Server-Only — PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Chọn 1 trong 2 phương thức đồng bộ đám mây:
# Cách A: PostgreSQL trực tiếp (Neon / Supabase Pooler)
DATABASE_URL=

# Cách B: Supabase REST RPC Sync (Server-Only, không expose qua NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
HNBEE_SYNC_SECRET=
